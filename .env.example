# Java Order Facts API. This value is configuration, never business-logic hardcoding.
JAVA_MARKET_BASE_URL=http://127.0.0.1:8091
JAVA_MARKET_TIMEOUT_SECONDS=2.0
# Development/test only. Production identity must come from authenticated middleware.
JAVA_MARKET_ENABLE_DEV_AUTH_HEADER=true

# Optional OpenAI-compatible DecisionModel. Configure all three values to enable
# the dynamic Agent Loop in FastAPI. Never commit a real key.
LLM_MODEL=example-model
LLM_API_KEY=replace-with-your-secret
LLM_BASE_URL=https://provider.example/v1
LLM_TIMEOUT=10
